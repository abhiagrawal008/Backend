<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 900px;
      margin: 50px auto;
      padding: 20px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid #ddd;
    }
    th {
      background-color: #4CAF50;
      color: white;
    }
    tr:nth-child(even) {
      background-color: #f7f7f7;
    }
  </style>
</head>
<body>
  <h1><%= title %></h1>
  <table>
    <thead>
      <tr>
        <th>Day</th>
        <th>Time</th>
        <th>Subject</th>
        <th>Faculty</th>
      </tr>
    </thead>
    <tbody>
      <% timetable.forEach(function(slot) { %>
        <tr>
          <td><%= slot.day %></td>
          <td><%= slot.time %></td>
          <td><%= slot.subject %></td>
          <td><%= slot.faculty %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <% if (timetable.length === 0) { %>
    <p>No classes scheduled.</p>
  <% } %>
</body>
</html>
