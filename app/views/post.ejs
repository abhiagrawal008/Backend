<%- include("partials/header", { pageTitle: post.title }) %>

<div class="post-actions">
    <a href="/posts" class="back">&larr; All posts</a>
    <a href="/posts/<%= post._id %>/edit" class="btn btn-outline btn-small">Edit post</a>
</div>

<article class="post">
    <h1><%= post.title %></h1>

    <div class="meta-row">
        <span class="avatar"><%= post.author.charAt(0).toUpperCase() %></span>
        <span class="meta">
            <span class="author"><%= post.author %></span>
            <span class="dot">&middot;</span>
            <%= formatDate(post.createdAt) %>
            <% if (post.updatedAt) { %>
                <span class="dot">&middot;</span>
                Edited on <%= formatDate(post.updatedAt) %>
            <% } %>
        </span>
    </div>

    <div class="content"><%= post.content %></div>
</article>

<%- include("partials/footer") %>
